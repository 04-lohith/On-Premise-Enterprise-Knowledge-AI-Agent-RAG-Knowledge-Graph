# Flask Settings
FLASK_APP=app.app
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this

# Redis (Message Broker for Celery)
REDIS_URL=redis://redis:6379/0

# Neo4j (Graph Database)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Ollama (Local LLM - runs natively on host machine)
# Use host.docker.internal to connect from Docker to host
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Note: ChromaDB uses PersistentClient (local storage at /app/chroma_data)
# No CHROMA_HOST/PORT needed - data stored inside container
